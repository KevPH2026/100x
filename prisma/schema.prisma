generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String?
  company      String? // 公司名称
  phone        String? // 联系电话
  inviteCodeId String?  @unique
  quotaTotal   Int      @default(10) // 免费用户默认10张
  quotaUsed    Int      @default(0) // 已用张数
  expiresAt    DateTime? // 账号到期时间（null=永不过期）
  disabled     Boolean  @default(false)
  resetToken   String?  // 密码重置token
  resetExpAt   DateTime? // 重置token过期时间
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inviteCode   InviteCode?   @relation(fields: [inviteCodeId], references: [id])
  assets       Asset[]
  brands       UserBrand[]
  memories     UserMemory[]
  subscriptions Subscription[]

  @@map("users")
}

model InviteCode {
  id          String   @id @default(cuid())
  code        String   @unique
  quota       Int      @default(100) // 每个用户可生成张数
  validDays   Int?     // 注册后可用天数（null=永久，与quota叠加）
  maxUses     Int      @default(50) // 最大使用次数（多少个用户可用）
  currentUses Int      @default(0) // 已使用次数
  note        String? // Admin 备注
  createdAt   DateTime @default(now())

  users User[]

  @@map("invite_codes")
}

model Asset {
  id          String   @id @default(cuid())
  userId      String
  imageUrl    String // Vercel Blob URL
  brandName   String
  platform    String // IG Feed / TikTok / FB etc
  sceneLabel  String
  aspectRatio String
  headline    String? // 关联文案主标题
  sourceUrl   String? // 来源产品页
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assets")
}

// ─── 用户品牌档案 ──────────────────────────────────────────
model UserBrand {
  id             String   @id @default(cuid())
  userId         String
  brandName      String
  industry       String? // 行业：美妆/3C/服饰/食品...
  style          String? // 品牌风格：极简/奢华/活泼/科技...
  targetAudience String? // 目标人群
  colorPalette   Json? // 品牌色板 [{hex, name}]
  logoUrl        String? // 品牌logo
  notes          String? // 用户备注
  usageCount     Int      @default(1) // 生成次数（自动累加）
  lastUsedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brandName])
  @@map("user_brands")
}

// ─── 用户偏好记忆 ──────────────────────────────────────────
model UserMemory {
  id         String   @id @default(cuid())
  userId     String
  category   String // preference / pattern / insight / feedback
  key        String // 如: default_platform / color_preference / scene_preference
  value      String // 值（自由文本或JSON字符串）
  source     String? // auto / manual — 自动学习还是用户手动设置
  confidence Float    @default(1.0) // 置信度 0-1
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, key])
  @@map("user_memories")
}

model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

// ─── 游客使用记录 ──────────────────────────────────────────
model GuestLog {
  id           String   @id @default(cuid())
  ip           String? // IP地址（截断 /24）
  ua           String? // User-Agent
  fingerprint  String? // 浏览器指纹（如可用）
  brandName    String? // 输入的品牌名
  sellingPoint String? // 输入的卖点
  platform     String? // IG Feed / TikTok / FB
  aspectRatio  String? // 1:1, 9:16...
  imageUrl     String? // 生成的图片URL
  provider     String? // novart / tokenrouter
  success      Boolean  @default(true)
  error        String? // 失败原因
  createdAt    DateTime @default(now())

  @@map("guest_logs")
}

// ─── 完整生成日志（注册用户+游客通用）─────────────────────
model GenerationLog {
  id            String   @id @default(cuid())
  userId        String? // 注册用户ID（null=游客）
  ip            String? // IP（截断 /24）
  brandName     String // 品牌名
  prompt        String // 实际发给模型的完整prompt
  sceneLabel    String? // 场景标签
  sceneDesc     String? // 场景描述（用户提供的）
  aspectRatio   String? // 宽高比
  platform      String? // 投放平台
  style         String? // 风格
  mood          String? // 氛围
  targetCountry String? // 目标国家
  imageModel    String? // 使用的生图模型
  imageUrl      String? // 生成的图片URL
  imagePrompt   String? // 用户的原始输入消息
  workflow      Json? // 完整工作流快照 { llmModel, imageProvider, novartImageModel, ... }
  success       Boolean  @default(true)
  error         String? // 失败原因
  latencyMs     Int? // 耗时(毫秒)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([brandName])
  @@index([createdAt])
  @@map("generation_logs")
}

// ─── 模型健康监测日志 ────────────────────────────────────────
model ModelHealthLog {
  id        String   @id @default(cuid())
  name      String   // 服务名：MiniMax-Text-01 / nova-image-pro / Neon / Blob / NextAuth
  ok        Boolean  // 本次探测是否正常
  latencyMs Int      // 响应延迟(ms)
  detail    String?  // 成功时返回摘要，失败时返回错误信息
  type      String   // LLM / Image / Database / Storage / Auth
  createdAt DateTime @default(now())

  @@index([name])
  @@index([createdAt])
  @@index([ok])
  @@map("model_health_logs")
}

// ─── 用户反馈 ────────────────────────────────────────────
model Feedback {
  id        String   @id @default(cuid())
  userId    String?  // 注册用户ID，未登录为null
  ip        String?  // 未登录用户IP（截断/24）
  page      String   // 当前页面路径
  content   String   // 反馈内容
  contact   String?  // 用户留的联系方式（可选）
  status    String   @default("pending") // pending / resolved / dismissed
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("feedbacks")
}

// ── 全量交互日志（细粒度链路追踪） ────────────────────────────────────────
model InteractionLog {
  id        String   @id @default(cuid())
  traceId   String   // 一次完整生成流程的唯一标识，用于串联所有步骤
  userId    String?  // 注册用户ID，未登录为null
  ip        String?  // 未登录用户IP（截断/24）
  
  step      String   // 步骤类型:
                     //   user_input        — 用户原始输入（文字/图片）
                     //   intent_analysis   — LLM意图分析结果
                     //   prompt_build      — 构造的图片生成prompt（完整文本）
                     //   llm_call         — LLM调用（请求/响应摘要）
                     //   image_request     — 发给图片模型的请求参数
                     //   image_response    — 图片模型返回（URL/错误）
                     //   user_feedback     — 用户对结果的操作（下载/重试/放弃）
                     //   error             — 任何步骤出错
  
  source    String   // 来源页面: chat / get / agent
  
  // 用户侧数据
  userInput       String?  // 用户输入的文字内容
  userImageRef    String?  // 用户上传的参考图URL（blob或base64前50字符）
  
  // LLM侧数据
  intent          String?  // 检测到的意图: greet/analyze_url/generate/edit/etc
  intentDetail    String?  // 意图分析详情（JSON或文本）
  llmPrompt       String?  // 实际发给LLM的完整prompt
  llmResponse     String?  // LLM返回的原始内容（截断到2000字符）
  llmModel        String?  // 使用的LLM模型名
  llmLatencyMs    Int?     // LLM响应耗时
  
  // 图片生成侧数据
  imageModel      String?  // 使用的图片模型名（如nova-image-pro）
  imageUrl        String?  // 生成的图片URL
  imageError      String?  // 图片生成错误信息
  imageLatencyMs  Int?     // 图片生成耗时
  
  // 业务数据
  brandName       String?  // 品牌名
  platform        String?  // 目标平台
  scene           String?  // 场景描述
  ratio           String?  // 图片比例
  
  // 反馈数据
  feedbackAction  String?  // 用户操作: download / retry / skip / complain
  feedbackText    String?  // 用户反馈的文字
  
  // 自审查标记
  reviewFlag      String?  // 自审查标记: null / warning / error
  reviewNote      String?  // 自审查备注（问题描述）
  reviewedAt      DateTime? // 自审查时间

  createdAt DateTime @default(now())

  @@index([traceId])
  @@index([userId])
  @@index([step])
  @@index([source])
  @@index([reviewFlag])
  @@index([createdAt])
  @@map("interaction_logs")
}

// ─── 页面访问统计 ──────────────────────────────────────────────────────
model PageView {
  id        String   @id @default(cuid())
  page      String   // /landing, /chat, /get, /dashboard, /login, etc.
  referrer  String?  // 来源页面
  ip        String?  // IP（截断 /24）
  userAgent String?  // 浏览器UA
  userId    String?  // 注册用户（null=游客）
  country   String?  // 国家（从Vercel头解析）
  createdAt DateTime @default(now())

  @@index([page])
  @@index([userId])
  @@index([createdAt])
  @@map("page_views")
}

// ─── 用户/品牌级Prompt模板 ─────────────────────────────────
// Admin可以针对特定用户或品牌优化prompt，后续生成自动使用优化后的版本
model PromptTemplate {
  id        String   @id @default(cuid())
  userId    String?  // 如果是用户级模板（null=品牌级）
  brandName String?  // 如果是品牌级模板
  scope     String   // "user" | "brand" | "user_brand"
  label     String?  // Admin备注（如"优化版-v2"）
  prompt    String   // 优化后的prompt模板（支持{{vars}}变量替换）
  isActive  Boolean  @default(true) // 是否启用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([brandName])
  @@index([scope])
  @@map("prompt_templates")
}

// ─── LemonSqueezy订阅 ─────────────────────────────────────
model Subscription {
  id                String   @id @default(cuid())
  userId            String
  lsSubscriptionId  String   @unique // LemonSqueezy subscription ID
  lsOrderId         String?  // LemonSqueezy order ID
  lsProductId       Int?     // LemonSqueezy product ID (variant)
  status            String   @default("active") // active | paused | cancelled | expired | past_due
  tier              String   @default("pro")   // pro | team | ...
  plan              String   // monthly | yearly
  renewsAt          DateTime? // 下次续费时间
  endsAt            DateTime? // 到期/取消后的结束时间
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}
